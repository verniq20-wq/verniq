# ── App (build time) ─────────────────────────────────────────
# Where the app finds the Verniq server. Leave empty when the app is served
# by the Verniq server itself (Railway, `npm start`). The Android build sets it
# to the public server URL.
VITE_VERNIQ_API_URL=

# ── Server (run time) ────────────────────────────────────────
# Postgres connection string. Without it the server uses an embedded database
# (PGlite) — stored in PGLITE_DIR, or in memory if that is empty too.
DATABASE_URL=
PGLITE_DIR=
# Secret used to sign sign-in tokens. Use at least 32 random characters in production.
AUTH_SECRET=
PORT=3000
